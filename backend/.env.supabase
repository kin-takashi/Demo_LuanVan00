# ============================================================
# .env.supabase — Dùng khi deploy lên Render + Supabase
# Điền YOUR_DB_PASSWORD và YOUR_SERVICE_ROLE_KEY trước khi dùng
# ============================================================

# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://hzgxlmrpunxwihupwcfh.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imh6Z3hsbXJwdW54d2lodXB3Y2ZoIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODA1NjEzOTIsImV4cCI6MjA5NjEzNzM5Mn0.O70kB7Tse1yBrW_h_1I3lDWxd-vNHetS1kVheKE2K7w
SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Database (PostgreSQL Supabase) ───────────────────────────
# Lấy từ: Supabase Dashboard → Settings → Database → Connection string
# Dùng "Transaction pooler" (port 6543) cho Render
DATABASE_URL=postgresql+psycopg2://postgres.hzgxlmrpunxwihupwcfh:Hieu.than75033@aws-1-ap-northeast-2.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql+psycopg2://postgres:Hieu.than75033@db.hzgxlmrpunxwihupwcfh.supabase.co:5432/postgres

# ── JWT ──────────────────────────────────────────────────────
SECRET_KEY=DIF6w2kTvojMHOwgeJ5k/486CJfzA1IZM5l1UYWKN4EZwQNIH5UEJag4gpNeSf2g2QrQoZJDDa6zeRcuv2ZVSw==
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Server ───────────────────────────────────────────────────
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
DEBUG=False
ENVIRONMENT=production

# ── CORS (điền domain Vercel sau khi deploy frontend) ────────
FRONTEND_URL=https://YOUR_APP.vercel.app
ALLOWED_ORIGINS=https://YOUR_APP.vercel.app

# ── Redis (nếu dùng Redis cloud, bỏ trống nếu không dùng) ───
REDIS_HOST=
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=INFO
